<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Bloom</string>
	<key>CFBundleDisplayName</key>
	<string>Bloom</string>
	<key>CFBundleIdentifier</key>
	<string>be.spatie.bloom</string>
	<key>CFBundleExecutable</key>
	<string>Bloom</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>Bloom</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<!--
	    Sparkle. The two values below are placeholders on purpose: the bucket the appcast will be
	    published to does not exist yet, and a real-looking default is the one thing that could
	    make a build check a host nobody owns.

	    build.sh fills them in from the environment:

	      BLOOM_UPDATE_FEED_URL     the appcast, e.g. https://<bucket-host>/appcast.xml
	      BLOOM_UPDATE_PUBLIC_KEY   the base64 EdDSA public key printed by Sparkle's generate_keys

	    A build with either one missing keeps the placeholder, and `SoftwareUpdate.availability`
	    reads that as "not configured" and never starts the updater. The private half of the key
	    pair belongs in the release runner's secret store and in the macOS keychain of whoever
	    generated it. It must never be committed here.
	-->
	<key>SUFeedURL</key>
	<string>__BLOOM_UPDATE_FEED_URL__</string>
	<key>SUPublicEDKey</key>
	<string>__BLOOM_UPDATE_PUBLIC_KEY__</string>
	<!--
	    Present so Sparkle does not ask on second launch whether it may check. The question is
	    answered here and the answer is offered as a switch in Settings, which is where the rest of
	    Bloom's system preferences live. Sparkle owns the preference from then on: see
	    `UpdateSettingsSection` for why there is deliberately no @AppStorage mirror of it.
	-->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- A day. See `SoftwareUpdate.checkInterval`, which is the same number. -->
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- Nothing is downloaded before the user has said yes. See `SoftwareUpdater.start`. -->
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<!-- No anonymous system profile is sent with the check. -->
	<key>SUEnableSystemProfiling</key>
	<false/>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>New Bloom Workspace</string>
			</dict>
			<key>NSMessage</key>
			<string>createWorkspaceFromSelection</string>
			<key>NSPortName</key>
			<string>Bloom</string>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>be.spatie.bloom.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bloom</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
